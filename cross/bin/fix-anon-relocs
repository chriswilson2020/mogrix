#!/usr/bin/env python3
"""
Fix anonymous R_MIPS_REL32 relocations for IRIX rld compatibility.

IRIX rld's fix_all_defineds() iterates .dynsym starting at index 1,
but only processes symbols where:
    (st_other != 0 && st_other != 4) || (binding == STB_LOCAL)

LLD emits all R_MIPS_REL32 as anonymous (sym_idx=0), but rld skips
index 0 entirely. LLD also doesn't put LOCAL symbols in .dynsym.

Additionally, rld's find_reloc() backward-walk always skips entry [0]
of .rel.dyn (boundary check: base == ptr-8).

This tool uses a TWO-SYMBOL approach to handle both issues:
1. Pick two DEFINED symbols from .dynsym, set both to STV_PROTECTED
2. Assign exactly ONE repointed reloc to sym1 (lower index) — this one
   goes to position [0] after sorting. find_reloc's binary search returns
   index 0 directly (skipping the backward walk entirely).
3. Assign remaining repointed relocs to sym2 (higher index) — these go
   to positions [1..N-1]. find_reloc finds them via binary search +
   backward walk, which stops at [0] (different sym_idx).
4. Both symbols processed by fix_all_defineds (STV_PROTECTED triggers it).

Result: ALL entries processed, no sacrifice needed.

Modes:
  Default:  Phase 0 (STV_PROTECTED) + Phase 1/2 (repoint anonymous relocs).
            Run at link time by irix-ld.
  --pre-resolve-only:  Phase 0b only (pre-resolve UND symbol relocs using
            rebased library symbol tables from --lib-path). Run at bundle
            time after mrqs rebases libraries.
"""

import os
import struct
import sys
import shutil
from pathlib import Path

# Import shared ELF utilities from cross/lib/
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))

from elf_utils import (
    read_u8, read_u16, read_u32, read_s32,
    write_u8, write_u16, write_u32,
    is_mips_n32_elf, find_sections, find_dynstr, get_string,
    find_dynamic_tags, build_load_segments, vaddr_to_foff,
    get_needed_libraries, get_rpath, find_library_file,
    parse_library_symbols, build_library_symbol_map,
    R_MIPS_REL32, STB_LOCAL, STV_PROTECTED,
    DT_MIPS_GOTSYM, DT_MIPS_SYMTABNO,
)

# Default library search paths for cross-compiled IRIX n32 binaries.
# Overridable via IRIX_LIB_PATH environment variable (colon-separated).
DEFAULT_LIB_PATHS = [
    '/opt/sgug-staging/usr/sgug/lib32',
]


def pre_resolve_rel32(data, sections, tags, load_segments, lib_paths=None):
    """Pre-resolve R_MIPS_REL32 relocations for UND (undefined) symbols."""
    dynsym = sections['dynsym']
    rel = sections['rel']
    dynstr = find_dynstr(data, sections)

    if dynstr is None:
        print("  Phase 0b: Cannot find .dynstr — skipping pre-resolve", file=sys.stderr)
        return 0

    rel_off = rel['offset']
    rel_end = rel_off + rel['size']

    und_sym_indices = set()
    while rel_off < rel_end:
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF
        if rtype == R_MIPS_REL32 and sym_idx > 0:
            sym_off = dynsym['offset'] + sym_idx * 16
            st_shndx = read_u16(data, sym_off + 14)
            if st_shndx == 0:
                und_sym_indices.add(sym_idx)
        rel_off += 8

    if not und_sym_indices:
        return 0

    und_sym_names = {}
    for idx in und_sym_indices:
        sym_off = dynsym['offset'] + idx * 16
        st_name_off = read_u32(data, sym_off)
        if st_name_off:
            try:
                name = get_string(data, dynstr['offset'], st_name_off)
                und_sym_names[idx] = name
            except (ValueError, IndexError):
                und_sym_names[idx] = None
        else:
            und_sym_names[idx] = None

    print(f"  Phase 0b: Pre-resolving R_MIPS_REL32 for {len(und_sym_indices)} UND symbols")
    for idx in sorted(und_sym_indices):
        name = und_sym_names.get(idx, '<unknown>')
        print(f"    UND sym[{idx}]: {name}")

    symbol_map, lib_stats = build_library_symbol_map(
        data, sections, tags, extra_lib_paths=lib_paths
    )

    for lib_name, lib_path in lib_stats['libs_found']:
        print(f"    Loaded: {lib_name} ({lib_path})")
    for lib_name in lib_stats['libs_missing']:
        print(f"    WARNING: Library not found: {lib_name}")
    print(f"    Symbol map: {lib_stats['total_symbols']} symbols from "
          f"{len(lib_stats['libs_found'])} libraries")

    resolved_addrs = {}
    unresolved = []
    for idx in sorted(und_sym_indices):
        name = und_sym_names.get(idx)
        if name and name in symbol_map:
            resolved_addrs[idx] = symbol_map[name]
            print(f"    Resolved: {name} -> 0x{symbol_map[name]:08x}")
        else:
            unresolved.append((idx, name))

    if unresolved:
        for idx, name in unresolved:
            print(f"    WARNING: Cannot resolve UND sym[{idx}] '{name}' — "
                  f"not found in any NEEDED library")

    if not resolved_addrs:
        print("  Phase 0b: No UND symbols could be resolved — skipping")
        return 0

    resolved_count = 0
    skipped_count = 0
    oob_count = 0
    rel_off = rel['offset']
    while rel_off < rel_end:
        r_offset = read_u32(data, rel_off)
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF

        if rtype == R_MIPS_REL32 and sym_idx in resolved_addrs:
            runtime_addr = resolved_addrs[sym_idx]
            target_file_off = vaddr_to_foff(r_offset, load_segments)
            if target_file_off is not None:
                addend = read_u32(data, target_file_off)
                new_val = (addend + runtime_addr) & 0xFFFFFFFF
                write_u32(data, target_file_off, new_val)
                write_u32(data, rel_off, 0)
                write_u32(data, rel_off + 4, 0)
                resolved_count += 1
            else:
                write_u32(data, rel_off, 0)
                write_u32(data, rel_off + 4, 0)
                oob_count += 1
        elif rtype == R_MIPS_REL32 and sym_idx > 0:
            sym_off = dynsym['offset'] + sym_idx * 16
            st_shndx = read_u16(data, sym_off + 14)
            if st_shndx == 0 and sym_idx not in resolved_addrs:
                skipped_count += 1
        rel_off += 8

    print(f"  Phase 0b: Pre-resolved {resolved_count} R_MIPS_REL32 relocations")
    if skipped_count:
        print(f"  Phase 0b: Skipped {skipped_count} unresolvable UND relocations")
    if oob_count:
        print(f"  Phase 0b: Zeroed {oob_count} out-of-bounds UND relocations")
    return resolved_count


def find_target_dynsym_indices(data, sections):
    dynsym = sections['dynsym']
    tags = find_dynamic_tags(data)
    symtabno = tags.get(DT_MIPS_SYMTABNO, 0)

    targets = []
    for idx in range(1, symtabno):
        sym_off = dynsym['offset'] + idx * 16
        st_shndx = read_u16(data, sym_off + 14)
        if st_shndx != 0 and st_shndx < 0xFF00:
            write_u8(data, sym_off + 13, STV_PROTECTED)
            targets.append(idx)
            if len(targets) == 2:
                break

    if len(targets) == 0:
        print("ERROR: No defined symbol found in .dynsym", file=sys.stderr)
        sys.exit(1)
    if len(targets) == 1:
        return (targets[0], None)
    return (targets[0], targets[1])


def fix_library(input_path, output_path=None, lib_paths=None, pre_resolve_only=False):
    if output_path is None:
        output_path = str(input_path) + '.fixed'

    data = bytearray(Path(input_path).read_bytes())
    sections = find_sections(data)
    tags = find_dynamic_tags(data)

    # A dynamically linked MIPS executable is not required to have .rel.dyn.
    # Simple programs can be satisfied entirely through GOT relocations. In that
    # case there is nothing for this tool to rewrite, so treat it as a successful
    # no-op instead of making every link look like a fixer failure.
    if 'rel' not in sections:
        if str(input_path) != str(output_path):
            shutil.copy2(input_path, output_path)
        print(f"Library: {input_path}")
        print("  No .rel.dyn section - nothing to fix")
        return

    # If relocations do exist, .dynsym is required to interpret their symbol
    # indices. Missing .dynsym in that case is a malformed/unsupported input.
    if 'dynsym' not in sections:
        print("ERROR: .rel.dyn is present but .dynsym is missing", file=sys.stderr)
        sys.exit(1)

    dynsym = sections['dynsym']
    rel = sections['rel']
    gotsym = tags.get(DT_MIPS_GOTSYM, 0)
    symtabno = tags.get(DT_MIPS_SYMTABNO, 0)

    load_segments = build_load_segments(data)

    if pre_resolve_only:
        print(f"Library: {input_path}")
        print(f"  .dynsym: {symtabno} entries, GOTSYM={gotsym}")
        resolved = pre_resolve_rel32(data, sections, tags, load_segments,
                                      lib_paths=lib_paths)
        if resolved > 0:
            Path(output_path).write_bytes(data)
            print(f"  Output written to: {output_path}")
        else:
            if str(input_path) != str(output_path):
                shutil.copy2(input_path, output_path)
            print("  No UND relocations to pre-resolve")
        return

    anon_count = 0
    named_count = 0
    rel_off = rel['offset']
    rel_end = rel_off + rel['size']
    while rel_off < rel_end:
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF
        if rtype == R_MIPS_REL32:
            if sym_idx == 0:
                anon_count += 1
            else:
                named_count += 1
        rel_off += 8

    total_relocs = rel['size'] // 8
    print(f"Library: {input_path}")
    print(f"  .dynsym: {symtabno} entries, GOTSYM={gotsym}")
    print(f"  .rel.dyn: {total_relocs} entries total")
    print(f"  R_MIPS_REL32: {anon_count} anonymous, {named_count} named")

    if anon_count == 0 and named_count == 0:
        print("  No R_MIPS_REL32 found - nothing to fix")
        if str(input_path) != str(output_path):
            shutil.copy2(input_path, output_path)
        return

    protected_count = 0
    rel_off = rel['offset']
    seen_syms = set()
    while rel_off < rel_end:
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF
        if rtype == R_MIPS_REL32 and sym_idx > 0 and sym_idx not in seen_syms:
            seen_syms.add(sym_idx)
            sym_off = dynsym['offset'] + sym_idx * 16
            st_other = read_u8(data, sym_off + 13)
            st_shndx = read_u16(data, sym_off + 14)
            if st_other == 0 and st_shndx != 0 and st_shndx < 0xFF00:
                write_u8(data, sym_off + 13, STV_PROTECTED)
                protected_count += 1
        rel_off += 8
    if protected_count > 0:
        print(f"  Phase 0: Set STV_PROTECTED on {protected_count} defined symbols "
              f"with R_MIPS_REL32 relocs")

    if anon_count == 0 and named_count > 0:
        print("  No anonymous R_MIPS_REL32 - skipping repoint/sort (named relocs already fixed)")
        Path(output_path).write_bytes(data)
        return

    sym1_idx, sym2_idx = find_target_dynsym_indices(data, sections)
    two_symbol = sym2_idx is not None

    # Phase 1: pre-add st_value for named defined-symbol relocations.
    rel_off = rel['offset']
    while rel_off < rel_end:
        r_offset = read_u32(data, rel_off)
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF
        if rtype == R_MIPS_REL32 and sym_idx > 0:
            sym_off = dynsym['offset'] + sym_idx * 16
            st_value = read_u32(data, sym_off + 4)
            st_shndx = read_u16(data, sym_off + 14)
            if st_shndx != 0 and st_shndx < 0xFF00 and st_value != 0:
                target = vaddr_to_foff(r_offset, load_segments)
                if target is not None:
                    write_u32(data, target, (read_u32(data, target) + st_value) & 0xFFFFFFFF)
        rel_off += 8

    # Phase 2: repoint anonymous REL32 entries. With two symbols, the first
    # anonymous relocation is assigned to sym1 and all remaining to sym2.
    anon_seen = 0
    rel_off = rel['offset']
    while rel_off < rel_end:
        r_info = read_u32(data, rel_off + 4)
        sym_idx = r_info >> 8
        rtype = r_info & 0xFF
        if rtype == R_MIPS_REL32 and sym_idx == 0:
            target_idx = sym1_idx if (anon_seen == 0 or not two_symbol) else sym2_idx
            write_u32(data, rel_off + 4, (target_idx << 8) | R_MIPS_REL32)
            anon_seen += 1
        rel_off += 8

    # IRIX rld expects relocations grouped/sorted by symbol index.
    entries = []
    rel_off = rel['offset']
    while rel_off < rel_end:
        entries.append(bytes(data[rel_off:rel_off + 8]))
        rel_off += 8
    entries.sort(key=lambda ent: read_u32(ent, 4) >> 8)
    rel_off = rel['offset']
    for ent in entries:
        data[rel_off:rel_off + 8] = ent
        rel_off += 8

    Path(output_path).write_bytes(data)
    print(f"  Phase 2: Repointed {anon_seen} anonymous R_MIPS_REL32 relocations")
    print(f"  Output written to: {output_path}")


def main():
    args = sys.argv[1:]
    pre_resolve_only = False
    lib_paths = None

    if '--pre-resolve-only' in args:
        pre_resolve_only = True
        args.remove('--pre-resolve-only')

    if '--lib-path' in args:
        idx = args.index('--lib-path')
        try:
            raw = args[idx + 1]
        except IndexError:
            print("ERROR: --lib-path requires a value", file=sys.stderr)
            return 2
        del args[idx:idx + 2]
        lib_paths = [p for p in raw.split(':') if p]

    if len(args) not in (1, 2):
        print(f"Usage: {sys.argv[0]} [--pre-resolve-only] [--lib-path PATHS] input [output]", file=sys.stderr)
        return 2

    input_path = args[0]
    output_path = args[1] if len(args) == 2 else None
    fix_library(input_path, output_path, lib_paths=lib_paths,
                pre_resolve_only=pre_resolve_only)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
